{
    "name":  "waswit",
    "version":  "0.1.0",
    "description":  "Workload-Aware Intelligent Selection between JavaScript and WebAssembly",
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js"
                          }
                },
    "scripts":  {
                    "build":  "tsup",
                    "postbuild":  "node -e \"require(\u0027fs\u0027).copyFileSync(\u0027../../frontend/src/wasm/waswit_wasm_bg.wasm\u0027, \u0027dist/waswit_wasm_bg.wasm\u0027)\""
                },
    "devDependencies":  {
                            "tsup":  "^8.0.2",
                            "typescript":  "^5.0.0"
                        },
    "files":  [
                  "dist",
                  "README.md"
              ]
}
