{
    "name":  "waswit",
    "version":  "0.1.0",
    "description":  "Workload-Aware Intelligent Selection between JavaScript and WebAssembly",
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krishbindal/WASWIT.git",
        "directory": "packages/waswit"
    },
    "homepage": "https://github.com/krishbindal/WASWIT#readme",
    "bugs": {
        "url": "https://github.com/krishbindal/WASWIT/issues"
    },
    "keywords": [
        "webassembly",
        "wasm",
        "javascript",
        "workload-selection",
        "adaptive-execution",
        "performance"
    ],
    "scripts":  {
                    "build":  "tsup",
                    "postbuild":  "node -e \"require(\u0027fs\u0027).copyFileSync(\u0027../../frontend/src/wasm/waswit_wasm_bg.wasm\u0027, \u0027dist/waswit_wasm_bg.wasm\u0027)\""
                },
    "devDependencies":  {
                            "tsup":  "^8.0.2",
                            "typescript":  "^5.0.0"
                        },
    "license": "MIT",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}
