{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/waswit-phase5-protocol.schema.json",
  "title": "Phase 5 Evaluation Record",
  "description": "Schema for a final Phase 5 evaluation run output in the WASWIT project.",
  "type": "object",
  "required": [
    "experimentRunId",
    "protocolVersion",
    "gitCommitSha",
    "config",
    "environmentMetadata",
    "policyVersion",
    "policyDerivationRule",
    "calibrationTimestamp",
    "cases",
    "status"
  ],
  "properties": {
    "experimentRunId": { "type": "string" },
    "protocolVersion": { "type": "string" },
    "gitCommitSha": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["workloadId", "evaluationGridSizes", "warmupIterations", "measurementIterations"],
      "properties": {
        "workloadId": { 
          "type": "string",
          "enum": ["matrix", "sort", "sha256"]
        },
        "evaluationGridSizes": {
          "type": "array",
          "items": { "type": "number" }
        },
        "warmupIterations": { 
          "type": "number",
          "minimum": 1
        },
        "measurementIterations": { 
          "type": "number",
          "exclusiveMinimum": 0
        },
        "generationParams": {
          "type": "object",
          "properties": {
            "matrixOffset": { "type": "number" }
          },
          "additionalProperties": false
        }
      }
    },
    "environmentMetadata": {
      "type": "object",
      "required": [
        "browser",
        "browserVersion",
        "browserEngine",
        "operatingSystem",
        "logicalProcessorCount",
        "deviceMemory",
        "crossOriginIsolated",
        "wasmBuildVersion",
        "wasmCompilerVersion",
        "timestamp"
      ],
      "properties": {
        "browser": { "type": "string" },
        "browserVersion": { "type": "string" },
        "browserEngine": { "type": "string" },
        "operatingSystem": { "type": "string" },
        "logicalProcessorCount": { "type": ["number", "string"] },
        "deviceMemory": { "type": ["number", "string"] },
        "crossOriginIsolated": { "type": ["boolean", "string"] },
        "wasmBuildVersion": { "type": "string" },
        "wasmCompilerVersion": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "additionalProperties": true
    },
    "policyVersion": { "type": ["string", "null"] },
    "policyDerivationRule": { "type": ["string", "null"] },
    "calibrationTimestamp": { "type": ["string", "null"] },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evaluationCaseId",
          "workloadId",
          "inputSize",
          "generationSpec",
          "jsTrials",
          "wasmTrials",
          "adaptiveTrials",
          "jsSummary",
          "wasmSummary",
          "adaptiveSummary"
        ],
        "properties": {
          "evaluationCaseId": { "type": "string" },
          "workloadId": { 
            "type": "string",
            "enum": ["matrix", "sort", "sha256"]
          },
          "inputSize": { 
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "generationSpec": {
            "type": "object",
            "required": ["generatorId"],
            "properties": {
              "generatorId": { "type": "string" },
              "parameters": {
                "type": "object",
                "additionalProperties": { "type": ["number", "string", "boolean"] }
              }
            }
          },
          "jsTrials": { "type": "array", "items": { "$ref": "#/$defs/trial" } },
          "wasmTrials": { "type": "array", "items": { "$ref": "#/$defs/trial" } },
          "adaptiveTrials": { "type": "array", "items": { "$ref": "#/$defs/trial" } },
          "jsSummary": { "$ref": "#/$defs/summaryOrNull" },
          "wasmSummary": { "$ref": "#/$defs/summaryOrNull" },
          "adaptiveSummary": { "$ref": "#/$defs/summaryOrNull" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["Idle", "Preparing", "Running", "Completed", "CompletedWithFailures", "Failed"]
    },
    "error": { "type": "string" }
  },
  "$defs": {
    "trial": {
      "type": "object",
      "required": ["trialIndex", "isWarmup", "executionMode", "timestamp"],
      "properties": {
        "trialIndex": { 
          "type": "integer",
          "minimum": 0
        },
        "isWarmup": { "type": "boolean" },
        "executionMode": {
          "type": "string",
          "enum": ["javascript", "wasm", "adaptive"]
        },
        "selectedRuntime": {
          "type": "string",
          "enum": ["javascript", "wasm"]
        },
        "selectionOverheadMs": { "type": "number" },
        "elapsedMs": { "type": "number" },
        "error": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "summaryOrNull": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["count", "min", "max", "mean", "median"],
          "properties": {
            "count": { "type": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "mean": { "type": "number" },
            "median": { "type": "number" }
          }
        }
      ]
    }
  }
}
